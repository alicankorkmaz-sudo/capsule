{
  "name": "@alicankorkmaz/capsule",
  "version": "0.1.0",
  "description": "Profile-based capability manager for Claude Code and Codex",
  "license": "MIT",
  "author": "Alican Korkmaz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alicankorkmaz/capsule.git"
  },
  "homepage": "https://github.com/alicankorkmaz/capsule#readme",
  "bugs": {
    "url": "https://github.com/alicankorkmaz/capsule/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "mcp",
    "cli",
    "profiles"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "caps": "dist/server/cli/index.js",
    "cx": "dist/server/profileCli.js"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch server/src/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/static": "^10.1.0",
    "@iarna/toml": "^2.2.5",
    "commander": "^15.0.0",
    "fastify": "^5.6.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
